# Optional local OpenAI setup. Gemini on the VM uses its attached identity.
# Keep this key on the server. Never use a VITE_ variable for it.
OPENAI_API_KEY=
# Provider switch: openai (default), gemini (GCP VM identity), or preview.
# The GCP tutorial selects gemini in the VM service configuration instead.
COURSE_PROVIDER=openai
# Optional absolute path on persistent storage. Defaults to backend/data/chat-budget.sqlite3.
# COURSE_BUDGET_DB=

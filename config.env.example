# Copy to config.env. Resource names must match your Google Cloud Console entries.
PROJECT_ID=replace-with-your-project-id
REGION=us-central1
ZONE=us-central1-a
PREFIX=gceweb
# Public IPv4 or DNS hostname, without a scheme/path. Set after reserving the IP.
# Leave empty while preparing accounts, registry, and the backend image.
DOMAIN=
# Choose the guide you are following: single-vm or alb-cdn.
DEPLOYMENT_MODE=single-vm
# Used by the ALB/CDN guide. The bucket name must be globally unique.
BUCKET=replace-with-your-project-id-web-public
# This local account pushes images and authenticates the IAP caller.
ACCESS_SERVICE_ACCOUNT=gceweb-access@replace-with-your-project-id.iam.gserviceaccount.com
# Path only; never put the JSON contents in this file.
SERVICE_ACCOUNT_KEY_FILE=secrets/gcp-service-account.json
